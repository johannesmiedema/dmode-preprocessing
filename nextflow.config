// nextflow.config

manifest {
    name = 'johannesmiedema/dmode-preprocessing'
    author = 'Luca Drescher, Johannes Miedema, Stefan Pastore'
    homePage = 'https://github.com/johannesmiedema/dmode-preprocessing'
    description = 'DModE Preprocessing - Differential modification and expression analysis framework'
    mainScript = 'main.nf'
    nextflowVersion = '>=22.10.0'
    version = '0.5.0'
}

//Epi2ME tags
epi2melabs {
    tags = "DModE, preprocessing"
    icon = "faIdCard"
}

// Default parameters
params {
    cpus = 0              // threads per job; 0 = automatic (see process block below)
    use_gpu = 'cuda:all'  // GPU specification: 'cuda:all', 'cuda:0', 'cuda:0,1', etc.
    aws_queue = null
    aws_region = 'us-east-1'
    outdir = './results'
    dmode_container = 'jmiedema/dmode:0.1'   // build with containers/dmode.Dockerfile
    max_basecalling = 1   // Dorado jobs at the same time (one GPU: keep 1)
    max_alignments  = 1   // minimap2 jobs at the same time, per reference (genome alignment ~19 GB RAM each)
    max_cpus        = 0   // total CPUs for all running jobs together (0 = all cores of the machine)
}

// Total CPU budget of the local executor: jobs only start while the sum of their cpus fits
executor {
    $local {
        cpus = params.max_cpus ?: Runtime.runtime.availableProcessors()
    }
}

// Global process defaults
process {
    // Threads per job (task.cpus in the scripts). With --cpus set, every job gets that many
    // (capped at the total, otherwise it could never start). Otherwise they are derived from
    // the total (--max_cpus or all cores): the heavy steps below get half of it, so a genome and a
    // transcriptome alignment fill the machine together; Dorado gets 12; all other steps get 4.
    cpus = {
        def total = (params.max_cpus ?: Runtime.runtime.availableProcessors()) as int
        params.cpus ? Math.min(params.cpus as int, total) : Math.min(4, total)
    }
    withName: 'MINIMAP2_ALIGN_GENOME|MINIMAP2_ALIGN_TRANSCRIPTOME|MODKIT_PILEUP_GENOME|MODKIT_PILEUP_TRANSCRIPTOME|OARFISH_INDEX|OARFISH_QUANT' {
        cpus = {
            def total = (params.max_cpus ?: Runtime.runtime.availableProcessors()) as int
            params.cpus ? Math.min(params.cpus as int, total) : Math.max(1, total.intdiv(2))
        }
    }
    withName: 'DORADO_BASECALL' {
        cpus = {
            def total = (params.max_cpus ?: Runtime.runtime.availableProcessors()) as int
            params.cpus ? Math.min(params.cpus as int, total) : Math.min(12, total)
        }
    }

    // Container definitions
    withName: 'DORADO_BASECALL' {
        container = 'ontresearch/dorado:sha9809639e07a927bcc0f584dadd5e59674cf59f3f'
        containerOptions = '--gpus all'  // GPU access for Docker container
        maxForks = params.max_basecalling
    }
    withName: 'MINIMAP2_ALIGN_GENOME' {
        container = 'nanozoo/minimap2:2.31--c2b4c91'
        maxForks = params.max_alignments
    }
    withName: 'MINIMAP2_ALIGN_TRANSCRIPTOME' {
        container = 'nanozoo/minimap2:2.31--c2b4c91'
        maxForks = params.max_alignments
    }
    withName: 'CHECK_UBAM' {
        container = 'nanozoo/minimap2:2.31--c2b4c91'
        cpus = 1
    }
    withName: 'DMODE|DMODE_REPORT' {
        container = params.dmode_container
    }
    withName: 'MODKIT_PILEUP_GENOME' {
        container = 'quay.io/biocontainers/ont-modkit:0.6.4--h7f49ad2_0'
    }
    withName: 'MODKIT_PILEUP_TRANSCRIPTOME' {
        container = 'quay.io/biocontainers/ont-modkit:0.6.4--h7f49ad2_0'
    }    
    withName: 'OARFISH_INDEX|OARFISH_QUANT' {
        container = 'quay.io/biocontainers/oarfish:0.13.0--hd727d2a_0'
    }
    withName: 'FEATURECOUNTS_GENOME' {
        container = 'quay.io/biocontainers/subread:2.1.1--h577a1d6_0'
    }

    withName: 'NANOCOMP' {
        container = 'quay.io/biocontainers/nanocomp:1.25.6--pyhdfd78af_0'
    }
}





profiles {
    // the "standard" profile is used implicitely by nextflow
    // if no other profile is given on the CLI
    standard {
        docker {
            enabled = true
            // this ensures container is run as host user and group, but
            //    also adds host user to the within-container group
            runOptions = "--user \$(id -u):\$(id -g) --group-add 100"
        }
    }

    // using singularity instead of docker
    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
    }


    // keep stub conda profile to prevent unknown profile warning so users get a better error
    conda {
        conda.enabled = true
    }


    // local profile for simplified development testing
    local {
        process.executor = 'local'
    }
}



timeline {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/timeline.html"
}
report {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/report.html"
}
trace {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/trace.txt"
}

env {
    PYTHONNOUSERSITE = 1
    JAVA_TOOL_OPTIONS = "-Xlog:disable -Xlog:all=warning:stderr"
}
